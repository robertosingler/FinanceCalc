# Copia este archivo a .env y completa tus valores reales.
# Nunca subas el archivo .env (con valores reales) a git.

# Clave para firmar las cookies de sesion. Genera una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esto-por-una-clave-aleatoria-larga

# Credenciales OAuth de Google Cloud Console (ver README para el paso a paso).
GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu-client-secret

# Emails (separados por coma) con acceso a /admin/users
ADMIN_EMAILS=tu-email@gmail.com
